<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Aadhaar_Number_12_Digits</fullName>
    <active>true</active>
    <description>Aadhaar Number must contain exactly 12 numeric digits.</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Aadhaar_Number__c)),
    OR(
        LEN(Aadhaar_Number__c) != 12,
        NOT(REGEX(Aadhaar_Number__c, &quot;^[0-9]{12}$&quot;))
    )
)</errorConditionFormula>
    <errorDisplayField>Aadhaar_Number__c</errorDisplayField>
    <errorMessage>Aadhaar Number must contain exactly 12 numeric digits.</errorMessage>
</ValidationRule>
